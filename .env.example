# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  (cp .env.example .env)

# https://opendart.fss.or.kr 에서 회원가입 후 '인증키 신청' (무료, 일 20,000회)
DART_API_KEY=

# https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=

# 선택 사항
# CLAUDE_MODEL=claude-sonnet-5-5
# EMBED_MODEL=jhgan/ko-sroberta-multitask
# CHUNK_SIZE=800
# CHUNK_OVERLAP=150
# TOP_K=6

# 배포할 때만 (Streamlit Cloud 의 Secrets 에 넣으세요)
# APP_PASSWORD=데모비밀번호
# DAILY_LIMIT=50
# SEARCH_MODE=keyword
